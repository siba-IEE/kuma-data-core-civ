# Modèle d'environnement de PRODUCTION de l'API publique Kuma Data Core.
# (ADR-0003, WP8). Copier en .env.prod (jamais versionné), remplir avec des
# secrets forts et DISTINCTS, puis :
#   docker compose -f docker/docker-compose.prod.yml --env-file .env.prod up -d
#
# Règle de sécurité : chaque rôle a son propre mot de passe. Ne JAMAIS
# réutiliser le mot de passe superutilisateur pour l'API.

# === Domaine (TLS automatique Caddy) ===
KUMA_DOMAINE=api.exemple-a-remplacer.org

# === PostgreSQL superutilisateur (administration, provisioning) ===
# Sert UNIQUEMENT à provisionner rôles/bases et publier les éditions.
# L'API ne l'utilise jamais.
POSTGRES_SUPERUSER=kuma_admin
POSTGRES_SUPERUSER_PASSWORD=changeme_superuser_fort

# === Rôle lecture seule (l'API lit l'édition avec ce rôle) ===
API_RO_PASSWORD=changeme_ro_fort

# === Rôle de service (écriture confinée à kuma_api_meta, D2) ===
# DISTINCT du rôle lecture seule : c'est ce qui tient la moindre privilège.
API_SERVICE_PASSWORD=changeme_service_fort

# === Base d'édition active (écrite par publier-edition.sh dans le pointeur) ===
EDITION_DB=kuma_edition_a_renseigner

# === Redis (compteurs de quota) ===
REDIS_PASSWORD=changeme_redis_fort

# === Clé administrateur de l'API (révocation de clés) ===
# Obligatoire et NON VIDE en prod (le démarrage échoue sinon).
API_CLE_ADMIN=changeme_cle_admin_forte
