# Modèle de fichier d'environnement pour Kuma Data Core (développement local).
#
# Ce fichier sert de référence. Il est versionné dans le dépôt.
#
# Pour l'utiliser :
#   1. Copier ce fichier à la racine du projet sous le nom `.env`
#      (cp docker/.env.example .env)
#   2. Remplacer les valeurs `changeme_*` par des mots de passe forts.
#   3. Ne jamais committer le fichier `.env` (il est ignoré par .gitignore).
#
# IMPORTANT : ces mots de passe sont destinés UNIQUEMENT à l'environnement
# local de développement. Ils ne doivent JAMAIS être utilisés en production.
# Les secrets de production seront gérés via un gestionnaire dédié (à définir).

# === PostgreSQL ===
POSTGRES_USER=kuma_admin
POSTGRES_PASSWORD=changeme_motdepasse_postgres_local_uniquement
POSTGRES_DB=kuma_data_core

# === Redis ===
REDIS_PASSWORD=changeme_motdepasse_redis_local_uniquement

# === Seeds initiaux ===
# Email du contributeur principal inséré par la migration 001
# (creer_table_contributeurs). Si cette variable n'est pas définie, la
# valeur de fallback est "editeur.principal@kuma-science.org" (cf.
# kuma_data_core.core.config.Settings).
KUMA_INITIAL_EDITOR_EMAIL=editeur.principal@kuma-science.org

# === API (étape 4) ===
# Environnement applicatif. ``prod`` impose api_docs_actives=false,
# log_format=json et api_cle_admin obligatoire (validateur Settings).
API_ENVIRONNEMENT=dev
# Documentation OpenAPI (/docs, /redoc, /openapi.json). À désactiver en prod.
API_DOCS_ACTIVES=true
# Clés API valides en phase 0 (stockage en variables d'environnement).
# Génération recommandée :
#   python -c "import secrets; print(f'kuma_dev_solar_{secrets.token_urlsafe(32)}')"
#   python -c "import secrets; print(f'kuma_dev_admin_{secrets.token_urlsafe(32)}')"
# Migration vers une table cles_api prévue en phase 1.
API_CLE_SOLAR_BRIDGE=changeme_kuma_dev_solar_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_CLE_ADMIN=changeme_kuma_dev_admin_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# === Logging ===
# ``texte`` en dev (lisible humainement, couleurs), ``json`` en prod.
LOG_FORMAT=texte
LOG_NIVEAU=INFO
